{
  "name": "nonstop-boxing-huelle",
  "version": "1.0.0",
  "private": true,
  "description": "App-Hülle (Capacitor) für Nonstop Boxing. Die App selbst liegt im Hauptordner (index.html, app.js, ...).",
  "scripts": {
    "pruefen": "node tools/pruefe.mjs",
    "www": "node tools/build-www.mjs",
    "sync": "node tools/build-www.mjs && cap sync",
    "ios:prepare": "node tools/prepare-ios.mjs",
    "ios:testflight": "bash tools/testflight.sh",
    "ios:iphone": "bash tools/iphone.sh",
    "android:prepare": "node tools/prepare-android.mjs",
    "android:test": "bash tools/android.sh"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
